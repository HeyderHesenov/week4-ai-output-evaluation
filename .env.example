# ---------------------------------------------------------------------------
# Bu faylı .env adı ilə kopyalayın və öz açarlarınızı yazın:
#     cp .env.example .env
# .env faylı .gitignore-dadır və heç vaxt repo-ya göndərilmir.
# .env.example isə QƏSDƏN commit edilir — konfiqurasiyanın sənədi budur.
# ---------------------------------------------------------------------------

# === API açarları ==========================================================
# İKİ ayrı provayder istifadə olunur və bu təsadüf deyil:
#   - Cavabı ÜRƏDƏN model OpenAI-dir (qiymətləndirilən Week 2 RAG sistemi
#     text-embedding-3-small + gpt-4o-mini üzərində qurulub).
#   - Cavabı QİYMƏTLƏNDİRƏN hakim Anthropic-dir.
# Fərqli model ailəsi seçmək LLM-as-judge-in "self-preference bias"-ını
# (model öz üslubundakı cavaba yüksək bal verməyə meyllidir) struktur
# olaraq sıradan çıxarır. Ətraflı: docs/methodology.md → "Hakim qərəzliliyi".

# OpenAI API açarı — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-buraya-oz-acarinizi-yazin

# Anthropic API açarı — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-buraya-oz-acarinizi-yazin

# === Qiymətləndirilən sistem (system under test) ============================
# Week 2 RAG sistemi submodule kimi vendor/ altındadır:
#     git submodule update --init --recursive
# Öz klonunuzu istifadə etmək istəsəniz, mütləq yolu buraya yazın.
SUT_PATH=vendor/week2-rag-document-qa

# SUT-un PİN EDİLMİŞ commit-i. RagSut işə düşərkən `git rev-parse HEAD`
# müqayisə edir və uyğunsuzluqda İMTİNA edir. "Week 2 sistemini
# dəyişdirmədən qiymətləndirdik" iddiası beləliklə yoxlanan invarianta
# çevrilir — söz deyil, assert.
SUT_COMMIT=19f14c38d619371dd337acaa0624031f3f855f30

# SUT-un grounding rejimi. `strict` deterministikdir və ƏLAVƏ LLM çağırışı
# ETMİR; `llm` rejimində hər cavab üçün ikinci bir model çağırışı gedir.
# Bu dəyər manifestə yazılır, çünki token hesabatının nəyi əhatə etdiyi
# ondan asılıdır.
GROUNDING_MODE=strict

# === Modellər ==============================================================
# Generator SUT-un öz modelidir; burada YALNIZ manifestə yazmaq və xərci
# hesablamaq üçün təkrarlanır. SUT Settings-i açıq override ilə qurulur.
GENERATOR_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Hakim modeli. Dəyişdirsəniz, BÜTÜN hakim-törəmə rəqəmlər (kappa, verbosity
# qərəzi, injection müqaviməti) etibarsızlaşır — buna görə hər verdikt
# özü ilə birlikdə judge_model və judge_prompt_sha256 saxlayır.
JUDGE_MODEL=claude-opus-5

# Hakimin çıxış səyi: low | medium | high | xhigh | max
# `low` seçilib: rubrika ankerlidir və çıxış JSON sxemi ilə məcburidir,
# yəni dərin düşüncə əlavə dəqiqlik vermir, sadəcə xərc artırır.
JUDGE_EFFORT=low

# DİQQƏT: max_tokens düşüncəni DƏ əhatə edir və Opus 5-də düşüncə default
# açıqdır. 300 kimi "JSON üçün bol-bol" görünən dəyər düşüncənin ORTASINDA
# kəsir və boş content-li `stop_reason: max_tokens` qaytarır — bu, təsadüfi
# hakim xətası kimi görünür. 1500 təhlükəsiz aşağı hədddir.
JUDGE_MAX_TOKENS=1500

# Hakim keçid həddi (0-3 ankerli şkalada). 2 = "əsasən düzgün".
JUDGE_PASS_THRESHOLD=2

# === Hakim şəbəkə davranışı ================================================
JUDGE_TIMEOUT=90.0
# Retry büdcəsi BÜTÜN run üçün paylaşılır, case başına deyil — beləliklə
# şəbəkə pisləşəndə xərc case sayına vurulmur.
JUDGE_MAX_RETRIES=4
JUDGE_RETRY_BASE_DELAY=1.0

# Hakim imtina edərsə (stop_reason: "refusal") başqa modelə keçmək üçün.
# QƏSDƏN BOŞDUR: səssiz model dəyişikliyi bütün qərəz ölçmələrini
# etibarsızlaşdırardı, çünki hansı modelin qiymətləndirdiyi artıq
# müəyyən olmazdı. Boş qalanda imtina `judge_error` kimi qeyd olunur və
# HEÇ VAXT 0 bala çevrilmir. Doldursanız, verdiktdə xidmət edən model
# (`served_model`) də saxlanılır.
JUDGE_FALLBACK_MODEL=

# === Run parametrləri ======================================================
# SUT temperature 0-da belə deterministik deyil. Holdout üçün 3 təkrar
# tövsiyə olunur — sürüşən case-lər `unstable_cases` kimi sadalanır və
# təmiz keçid sayılmır.
REPEATS=1

# === Yollar ================================================================
DATASET_PATH=data/testset.yaml
SPLIT_MANIFEST_PATH=data/split_manifest.json
PRICES_PATH=data/prices.yaml
VARIANTS_DIR=data/variants
RUNS_DIR=runs
LOGS_DIR=logs
